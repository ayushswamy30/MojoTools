# Copy to .env.local. Every value is optional in R0: without them the site runs in demo mode
# (enquiries are validated but not stored or emailed). Production needs all of them (TASKS T17.8).

# --- Public (shown to browsers) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only "true" for the real public launch; previews stay noindex.
NEXT_PUBLIC_SITE_INDEXABLE=false
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (never exposed to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
# Comma-separated list of people who receive enquiry alerts (open question C4).
ENQUIRY_ALERT_EMAILS=
TURNSTILE_SECRET_KEY=
